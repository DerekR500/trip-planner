# Copy to .env and adjust. .env is gitignored; this file is committed as the template.

# Port the Express server listens on.
PORT=3000

# Origin allowed to call this API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Postgres connection string.
# Running the backend on your host machine (npm run dev) -> host "localhost".
# Running the backend inside docker compose -> host "postgres" (the service name);
# docker-compose.yml sets that value itself, so this file is for local runs.
DATABASE_URL=postgresql://tripplanner:tripplanner@localhost:5432/tripplanner

# Google Routes API key — SERVER-SIDE ONLY. Never give this a VITE_ prefix and never send
# it to the browser. It must be a SEPARATE key from the frontend Maps key: that one is
# HTTP-referrer restricted, which blocks server-side calls. Restrict this one by IP
# (or leave unrestricted only for local dev) and to the Routes API alone.
GOOGLE_ROUTES_API_KEY=your-routes-api-key-here
