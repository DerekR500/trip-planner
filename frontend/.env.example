# Copy to .env to override. .env is gitignored; this file is committed as the template.

# Base URL of the backend API. App falls back to this same value if unset.
VITE_API_URL=http://localhost:3000

# ONE Google Maps Platform API key, restricted in the Cloud console to BOTH
# "Maps JavaScript API" and "Places API (New)". It is used in the browser — that is
# expected for Maps JS. Secure it with HTTP referrer + API restrictions, not by hiding it.
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key-here

# A Map ID (NOT a second key). Required for AdvancedMarker to render.
VITE_GOOGLE_MAPS_MAP_ID=your-map-id-here
